// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  nome         String       @db.VarChar(120)
  usuario      String       @unique @db.VarChar(40)
  senhaHash    String
  papel        PapelUsuario @default(OPERADOR_CADASTRO)
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@map("usuarios")
}

model Organizacao {
  id                 String    @id @db.VarChar(20)
  codigo             String?   @unique @db.VarChar(20)
  razaoSocial        String    @db.VarChar(200)
  cnpj               String    @unique @db.VarChar(14)
  inscricaoEstadual  String    @default("") @db.VarChar(30)
  enderecoCompleto   String    @default("") @db.Text
  telefone           String    @default("") @db.VarChar(20)
  email              String    @default("") @db.VarChar(254)
  dataCadastro       DateTime  @default(now())
  ativo              Boolean   @default(true)
  versao             Int       @default(1)
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
  lotes Lote[]

  contratoVigente    Contrato?

  @@map("organizacoes")
}

model Contrato {
  id                  String     @id @default(uuid()) @db.Uuid
  organizacaoId       String     @unique @db.VarChar(20)
  dataAssinatura      DateTime   @default(now())
  dataVencimento      DateTime
  clausulas           Int        @default(0)
  valorMensal         Decimal    @db.Decimal(12, 2)
  renovacaoAutomatica Boolean    @default(false)

  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
  CANCELADO
}

model Lote {
  id                 String     @id @db.VarChar(40)
  dataEntrada        DateTime   @default(now())
  organizacaoId      String     @db.VarChar(20)
  notaFiscal         String     @db.VarChar(100)
  transportadora     String     @db.VarChar(120)
  statusProcessamento StatusLote @default(RECEBIDO)
  observacoes        String     @default("") @db.Text

  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  equipamentos Equipamento[]

  @@index([organizacaoId])
  @@index([dataEntrada])
  @@map("lotes")
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Equipamento {
  id                   String              @id @default(uuid()) @db.Uuid
  codigoBarrasInterno  String              @unique
  tipo                 TipoEquipamento     @default(COMPUTADOR_MESA)
  marca                String              @default("")
  modelo               String              @default("")
  anoFabricacao        Int                 @default(0)
  estadoFisico         EstadoFisico        @default(NOVO)
  pesoQuilogramas      Float               @default(0)
  loteId               String              @db.VarChar(40)
  posicaoNoLote        Int                 @default(0)
  statusRastreamento   StatusRastreamento  @default(AGUARDANDO_TRIAGEM)

  lote                 Lote                @relation(fields: [loteId], references: [id], onDelete: Restrict)
  historicoMovimentacao Movimentacao[]

  @@index([loteId])
  @@index([statusRastreamento])
  @@map("equipamentos")
}

model Movimentacao {
  id            String      @id @default(uuid()) @db.Uuid
  equipamentoId String      @db.Uuid
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")

  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataHora])
  @@map("movimentacoes")
}