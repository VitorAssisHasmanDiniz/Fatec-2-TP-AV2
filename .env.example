# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# URL de conexão com o banco principal.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@localhost:5432/greencode?schema=public"

# Banco auxiliar usado pelo Prisma durante as migrations.
# Deve ser um banco separado do principal.
SHADOW_DATABASE_URL="postgresql://usuario:senha@localhost:5432/greencode_shadow?schema=public"

# Porta HTTP da API.
PORT=3000

# Autenticação JWT
# Segredo usado para assinar e validar os tokens JWT.
# Gere um valor seguro com: openssl rand -base64 32
JWT_SECRET="substitua_por_um_segredo_aleatorio"

# LOGS
# Níveis disponíveis: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL="info"

# Administrador inicial
# Credenciais usadas pelo script de seed para criar o administrador.
ADM_LOGIN="login_do_administrador"
ADM_SENHA="senha_do_administrador"
